# Precedence: process environment, then this file copied to .env, then the built-in default.
# Every key is optional.

# Wine prefix that holds the Steam install (macOS only), the directory that contains drive_c.
# The game directory is derived from it. Default: ~/.local/share/megabonk/wine for plain Wine, or
# ~/Library/Application Support/CrossOver/Bottles/Steam when MEGABONK_MACOS_RUNTIME=crossover.
# MEGABONK_WINE_PREFIX=~/.local/share/megabonk/wine

# Older spelling of the prefix setting: the prefix's drive_c directory. MEGABONK_WINE_PREFIX wins.
# MEGABONK_BOTTLE=

# Overrides the resolved game install directory directly (any platform), skipping the prefix
# derivation above. Default on macOS: $MEGABONK_WINE_PREFIX/drive_c/Program Files (x86)/Steam/steamapps/common/Megabonk
# Default on Windows: C:\Program Files (x86)\Steam\steamapps\common\Megabonk
# MEGABONK_GAME_DIR=

# macOS runtime that launches the game: wine (plain Wine, default) or crossover. Default: wine
# MEGABONK_MACOS_RUNTIME=wine

# Plain Wine binary used when the runtime is wine (macOS only).
# Default: ~/Applications/wine11/Wine Devel.app/Contents/Resources/wine/bin/wine
# MEGABONK_WINE=

# MelonLoader release to install (scripts/install_melonloader.py). Default: 0.7.3
# MELONLOADER_VERSION=0.7.3
# Archive used on macOS (CrossOver) and Windows: MelonLoader.x64.zip
# MELONLOADER_URL_WINDOWS=https://github.com/LavaGang/MelonLoader/releases/download/v0.7.3/MelonLoader.x64.zip
# MELONLOADER_SHA256_WINDOWS=5b2b2f3d1cd42b59ec886c5bdc2663edae87a0097a4f4a8f58c0965a99dda416
# Archive used on Linux (native build): MelonLoader.Linux.x64.zip
# MELONLOADER_URL_LINUX=https://github.com/LavaGang/MelonLoader/releases/download/v0.7.3/MelonLoader.Linux.x64.zip
# MELONLOADER_SHA256_LINUX=519f25639cde796a749ea0670daedfa251a45d0217608ac6e12c1bc6aa9e114f
