# Precedence: process environment, then this file copied to .env, then the built-in default.
# Every key is optional.

# Wine prefix that holds the Steam install (macOS only), the directory that contains drive_c.
# The game directory is derived from it. Default: ~/.local/share/megabonk/wine for plain Wine, or
# ~/Library/Application Support/CrossOver/Bottles/Steam when MEGABONK_MACOS_RUNTIME=crossover.
# MEGABONK_WINE_PREFIX=~/.local/share/megabonk/wine

# Older spelling of the prefix setting: the prefix's drive_c directory. MEGABONK_WINE_PREFIX wins.
# MEGABONK_BOTTLE=

# Overrides the resolved game install directory directly (any platform), skipping the prefix
# derivation above. Default on macOS: $MEGABONK_WINE_PREFIX/drive_c/Program Files (x86)/Steam/steamapps/common/Megabonk
# Default on Windows: C:\Program Files (x86)\Steam\steamapps\common\Megabonk
# MEGABONK_GAME_DIR=

# macOS runtime that launches the game: wine (plain Wine, default) or crossover. Default: wine
# MEGABONK_MACOS_RUNTIME=wine

# Enemy spawns after run.py relaunch and the MCP relaunch tool. Default: true; false stops them (send spawns on to start them)
# MEGABONK_RELAUNCH_SPAWNS=true

# Feathers (extra jumps) amount set after run.py relaunch and the MCP relaunch tool, 0 to 999. Default: 2; 0 leaves it alone
# MEGABONK_RELAUNCH_FEATHERS=2

# Make the player invulnerable after run.py relaunch and the MCP relaunch tool. Default: false
# MEGABONK_RELAUNCH_INVULNERABLE=false

# Skip the game's Character Selection screen for harness loads (read by the game process, so set it before launch).
# Default: false, so a load waits for a character to be confirmed on the screen, restricted to Calcium and Tony McZoom,
# and run.py relaunch never arms the kill floor. true starts the run at once as Tony McZoom unless a character is named.
# Name one with --character on run.py load and run.py relaunch, or the character argument of the MCP load tool:
#   calcium     Calcium, the skateboarder
#   tonymczoom  Tony McZoom (default); tony is accepted too
# Names are case-insensitive; any other name rejects the load.
# MEGABONK_DEV=false

# Plain Wine binary used when the runtime is wine (macOS only).
# Default: ~/Applications/wine11/Wine Devel.app/Contents/Resources/wine/bin/wine
# MEGABONK_WINE=

# MelonLoader release to install (scripts/install_melonloader.py). Default: 0.7.3
# MELONLOADER_VERSION=0.7.3
# Archive used on macOS (CrossOver) and Windows: MelonLoader.x64.zip
# MELONLOADER_URL_WINDOWS=https://github.com/LavaGang/MelonLoader/releases/download/v0.7.3/MelonLoader.x64.zip
# MELONLOADER_SHA256_WINDOWS=5b2b2f3d1cd42b59ec886c5bdc2663edae87a0097a4f4a8f58c0965a99dda416
# Archive used on Linux (native build): MelonLoader.Linux.x64.zip
# MELONLOADER_URL_LINUX=https://github.com/LavaGang/MelonLoader/releases/download/v0.7.3/MelonLoader.Linux.x64.zip
# MELONLOADER_SHA256_LINUX=519f25639cde796a749ea0670daedfa251a45d0217608ac6e12c1bc6aa9e114f

# MP3 transcode settings (scripts/transcode.py), which need FFmpeg on PATH.
# Encoder and probe binaries. Default: ffmpeg and ffprobe
# MEGABONK_FFMPEG=ffmpeg
# MEGABONK_FFPROBE=ffprobe

# libmp3lame VBR quality: 0 is LAME -V0 (the default), 2 is LAME -V2, 9 the smallest.
# MEGABONK_MP3_VBR_QUALITY=0

# Extension used for the derived output name. Default: .mp3
# MEGABONK_MP3_SUFFIX=.mp3

# Comma-separated tags warned about when the source has them and the MP3 lost them.
# MEGABONK_MP3_CORE_TAGS=title,artist,album,album_artist,composer,date,year,track,disc,genre,lyricist

# Checkout of JayFoxRox/thps2-tools, only needed the first time `task thps` extracts the Warehouse from the disc image.
# THPS2_TOOLS_DIR=

# Signing and notarization for `task package:macos`; without them the installer is only ad-hoc signed and not notarized.
# Developer ID Application identity in the login keychain (security find-identity -v -p codesigning)
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# App Store Connect API key used by notarytool: key ID, issuer UUID, and the base64 of the .p8 (openssl base64 -A -in AuthKey_XXXXXXXXXX.p8)
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_B64=
# Alternative to the API key: a notarytool keychain profile (xcrun notarytool store-credentials). Wins over the key.
# NOTARY_PROFILE=
