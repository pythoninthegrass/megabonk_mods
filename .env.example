# Precedence: process environment, then this file copied to .env, then the built-in default.
# Every key is optional.

# Wine prefix drive_c for the Steam install under CrossOver (macOS only). The game directory is
# derived from it. Default: ~/Library/Application Support/CrossOver/Bottles/Steam/drive_c
# MEGABONK_BOTTLE=~/Library/Application Support/CrossOver/Bottles/Steam/drive_c

# Overrides the resolved game install directory directly (any platform), skipping the bottle
# derivation above. Default on macOS: $MEGABONK_BOTTLE/Program Files (x86)/Steam/steamapps/common/Megabonk
# Default on Windows: C:\Program Files (x86)\Steam\steamapps\common\Megabonk
# MEGABONK_GAME_DIR=

# MelonLoader release to install (scripts/install_melonloader.py). Default: 0.7.3
# MELONLOADER_VERSION=0.7.3
# Archive used on macOS (CrossOver) and Windows: MelonLoader.x64.zip
# MELONLOADER_URL_WINDOWS=https://github.com/LavaGang/MelonLoader/releases/download/v0.7.3/MelonLoader.x64.zip
# MELONLOADER_SHA256_WINDOWS=5b2b2f3d1cd42b59ec886c5bdc2663edae87a0097a4f4a8f58c0965a99dda416
# Archive used on Linux (native build): MelonLoader.Linux.x64.zip
# MELONLOADER_URL_LINUX=https://github.com/LavaGang/MelonLoader/releases/download/v0.7.3/MelonLoader.Linux.x64.zip
# MELONLOADER_SHA256_LINUX=519f25639cde796a749ea0670daedfa251a45d0217608ac6e12c1bc6aa9e114f
