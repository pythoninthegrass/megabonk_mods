<Project>
  <!-- Untracked per-machine overrides, imported first so they feed the derived paths below -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup>
    <BottleFolder Condition="'$(BottleFolder)' == ''">$(HOME)/Library/Application Support/CrossOver/Bottles/Steam/drive_c</BottleFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">$(BottleFolder)/Program Files (x86)/Steam/steamapps/common/Megabonk</GameFolder>
    <MelonLoaderFolder Condition="'$(MelonLoaderFolder)' == ''">$(GameFolder)/MelonLoader/net6</MelonLoaderFolder>
    <Il2CppAssembliesFolder Condition="'$(Il2CppAssembliesFolder)' == ''">$(GameFolder)/MelonLoader/Il2CppAssemblies</Il2CppAssembliesFolder>
    <ModInstanceFolder Condition="'$(ModInstanceFolder)' == ''">$(GameFolder)/Mods</ModInstanceFolder>
  </PropertyGroup>
</Project>
