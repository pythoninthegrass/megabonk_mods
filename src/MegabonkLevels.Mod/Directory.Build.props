<Project>
  <PropertyGroup>
    <BottleFolder>$(HOME)/Library/Application Support/CrossOver/Bottles/Steam/drive_c</BottleFolder>
    <GameFolder>$(BottleFolder)/Program Files (x86)/Steam/steamapps/common/Megabonk</GameFolder>
    <MelonLoaderFolder>$(GameFolder)/MelonLoader/net6</MelonLoaderFolder>
    <Il2CppAssembliesFolder>$(GameFolder)/MelonLoader/Il2CppAssemblies</Il2CppAssembliesFolder>
    <ModInstanceFolder>$(GameFolder)/Mods</ModInstanceFolder>
  </PropertyGroup>
  <!-- Untracked per-machine overrides for the paths above -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
