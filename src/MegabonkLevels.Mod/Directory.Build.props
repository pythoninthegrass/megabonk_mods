<Project>
  <!-- Untracked per-machine overrides, imported first so they feed the derived paths below -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <!-- The same settings and precedence as scripts/game_paths.py, read from the environment (task loads .env into it); a leading ~ is expanded -->
  <PropertyGroup>
    <GameDirSetting>$([System.Text.RegularExpressions.Regex]::Replace('$(MEGABONK_GAME_DIR)', '^~(?=/|$)', '$(HOME)'))</GameDirSetting>
    <WinePrefixSetting>$([System.Text.RegularExpressions.Regex]::Replace('$(MEGABONK_WINE_PREFIX)', '^~(?=/|$)', '$(HOME)'))</WinePrefixSetting>
    <BottleSetting>$([System.Text.RegularExpressions.Regex]::Replace('$(MEGABONK_BOTTLE)', '^~(?=/|$)', '$(HOME)'))</BottleSetting>
  </PropertyGroup>
  <PropertyGroup>
    <BottleFolder Condition="'$(BottleFolder)' == '' And '$(WinePrefixSetting)' != ''">$(WinePrefixSetting)/drive_c</BottleFolder>
    <BottleFolder Condition="'$(BottleFolder)' == '' And '$(BottleSetting)' != ''">$(BottleSetting)</BottleFolder>
    <BottleFolder Condition="'$(BottleFolder)' == ''">$(HOME)/.local/share/megabonk/wine/drive_c</BottleFolder>
    <GameFolder Condition="'$(GameFolder)' == '' And '$(GameDirSetting)' != ''">$(GameDirSetting)</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">$(BottleFolder)/Program Files (x86)/Steam/steamapps/common/Megabonk</GameFolder>
    <BepInExCoreFolder Condition="'$(BepInExCoreFolder)' == ''">$(GameFolder)/BepInEx/core</BepInExCoreFolder>
    <Il2CppAssembliesFolder Condition="'$(Il2CppAssembliesFolder)' == ''">$(GameFolder)/BepInEx/interop</Il2CppAssembliesFolder>
    <ModInstanceFolder Condition="'$(ModInstanceFolder)' == ''">$(GameFolder)/BepInEx/plugins/MegabonkLevels</ModInstanceFolder>
  </PropertyGroup>
</Project>
