---
import GalleryLayout from '../../../layouts/GalleryLayout.astro';
import Icon from '../../../components/Icon.astro';
import LevelActions from '../../../components/LevelActions.astro';
---
<GalleryLayout title="Level · Megabonk Mod Party" description="A custom Megabonk level shared on megabonkmod.party." path="/levels/view/">
  <section class="gallery-page wrap" x-data="levelView" aria-live="polite">
    <noscript>
      <p class="gallery-note">The level gallery needs JavaScript. Without it you can still share levels by hand: see <a href="https://docs.megabonkmod.party/player-guide/#sharing-a-level">Sharing a level</a> in the player guide.</p>
    </noscript>

    <p class="gallery-status" x-show="state === 'loading'" x-cloak>Loading level…</p>

    <div class="gallery-message" x-show="state === 'notfound'" x-cloak>
      <h1>Level not found</h1>
      <p>There is no level with that share code. Check the code, or browse the gallery.</p>
      <a class="btn" href="/levels/">Browse levels <Icon name="arrow" /></a>
    </div>

    <div class="gallery-message" x-show="state === 'error'" x-cloak role="alert">
      <h1>The gallery is unreachable</h1>
      <p>The level server did not answer. Try again in a moment.</p>
      <button class="btn" data-variant="outline" type="button" @click="location.reload()">Try again</button>
    </div>

    <article class="level-page" x-show="state === 'ready'" x-cloak>
      <p class="crumb"><a href="/levels/">Levels</a></p>
      <div class="level-layout">
        <figure class="cover-plate large">
          <img :src="cover" :alt="`Cover picture for ${level?.title}`" width="1080" height="720" />
          <figcaption><span x-text="code"></span><span class="hidden-tag" x-show="level?.hidden">Hidden</span><LevelActions level="level" /></figcaption>
        </figure>
        <div class="level-info">
          <h1 x-text="level?.title"></h1>
          <p class="byline"><span>by <a class="maker-link" :href="creatorUrl(level?.author)" x-text="author"></a></span><span class="counts-inline"><button class="count-action" type="button" :aria-pressed="Boolean(liked)" :title="likeTitle()" :disabled="busy" @click="likeFromCounts()"><Icon name="heart" /><span x-text="plural(level?.likes, 'like')"></span><span class="sr-only" x-text="` for ${level?.title}`"></span></button><a class="count-action" :href="download" title="Download this level" @click="level.downloads += 1"><Icon name="download" /><span x-text="plural(level?.downloads, 'download')"></span><span class="sr-only" x-text="` of ${level?.title}`"></span></a></span></p>
          <div class="share-code"><code x-text="code" aria-label="Share code"></code><button class="btn" data-variant="outline" type="button" @click="copyCode()"><span x-text="copied ? 'Copied' : 'Copy code'"></span></button></div>
          <ul class="chips" x-show="level?.tags?.length"><template x-for="name in level?.tags" :key="name"><li x-text="name"></li></template></ul>
          <p class="description" x-show="level?.description" x-text="level?.description"></p>
          <div class="actions">
            <a class="btn" :href="download">Download level <Icon name="arrow" /></a>
          </div>
        </div>
      </div>

      <div class="level-details">
        <table class="meta-table">
          <caption class="sr-only">Level details</caption>
          <tbody>
            <tr class="echo"><th scope="row">Share code</th><td><code x-text="code"></code></td></tr>
            <tr><th scope="row">Maker</th><td><a class="maker-link" :href="creatorUrl(level?.author)" x-text="author"></a></td></tr>
            <tr><th scope="row">Uploaded</th><td x-text="uploaded"></td></tr>
            <tr><th scope="row">Map</th><td x-text="mapName(level?.map)"></td></tr>
            <tr><th scope="row">Schema</th><td x-text="level?.schemaVersion"></td></tr>
            <tr :class="packs.length ? 'needs-packs' : ''"><th scope="row">Required packs</th><td>
              <span x-show="packs.length === 0">None</span>
              <ul class="pack-list" x-show="packs.length"><template x-for="pack in packs" :key="pack.id"><li><code x-text="pack.id"></code> <span x-text="pack.version"></span></li></template></ul>
              <p class="small" x-show="packs.length">This level looks empty without these packs. <a href="https://docs.megabonkmod.party/player-guide/#installing-an-asset-pack">How to install an asset pack</a>. Pack files are not offered here.</p>
            </td></tr>
            <tr class="echo"><th scope="row">Likes</th><td x-text="level?.likes"></td></tr>
            <tr class="echo"><th scope="row">Downloads</th><td x-text="level?.downloads"></td></tr>
          </tbody>
        </table>

        <div class="install">
          <h2>Install it</h2>
          <ol>
            <li>Download the level. It saves as a <code>.mblevel.json</code> file.</li>
            <li>Copy it into <code>UserData/Levels/</code> in the Megabonk game folder.</li>
            <li>Optional: save the cover picture beside it with the same name, such as <code>my-level.png</code>, so Map Selection shows it.</li>
            <li>Start Megabonk. The level appears on Map Selection under its title.</li>
          </ol>
          <p class="small"><a href="https://docs.megabonkmod.party/player-guide/#finding-your-levels-folder">Where is my levels folder?</a></p>
        </div>
      </div>

      <section class="visibility" x-show="$store.session.isAdmin" x-cloak x-effect="if ($store.session.isAdmin) loadUsers()">
        <h2 class="quiet-heading">Visibility</h2>
        <label class="hide-toggle"><input type="checkbox" :checked="level?.hidden" @change="$store.session.toggleHidden(level)" /> Hidden from the public</label>
        <p class="small">A hidden level still shows for its maker, for site owners and for anyone listed under "Can see it while hidden". Anyone listed under "Cannot see it" loses a public level.</p>
        <template x-for="group in accessGroups" :key="group.field">
          <div class="access-group">
            <h3 x-text="group.title"></h3>
            <p class="small" x-show="accessIds(group.field).length === 0">Nobody.</p>
            <ul class="chips"><template x-for="id in accessIds(group.field)" :key="id"><li><span x-text="userName(id)"></span> <button type="button" @click="changeAccess(group.field, id, false)" :aria-label="`Remove ${userName(id)} from: ${group.title}`">&times;</button></li></template></ul>
            <select :aria-label="`Add a user to: ${group.title}`" @change="changeAccess(group.field, $event.target.value, true); $event.target.value = ''">
              <option value="">Add a user…</option>
              <template x-for="user in accessCandidates(group.field)" :key="user.id"><option :value="user.id" x-text="user.name || user.id"></option></template>
            </select>
          </div>
        </template>
        <p class="gallery-status" role="alert" x-show="$store.session.adminError" x-text="$store.session.adminError"></p>
      </section>

      <div class="social" id="social">
        <h2 class="quiet-heading">Like or report</h2>
        <div x-show="!$store.session.signedIn" class="signin-prompt">
          <p>Sign in to like or report this level.</p>
          <div class="providers">
            <template x-for="provider in $store.session.providers" :key="provider.id">
              <button class="btn" data-variant="outline" type="button" :disabled="$store.session.busy || !$store.session.oauthEnabled" @click="$store.session.signIn(provider.id)" x-text="`Sign in with ${provider.label}`"></button>
            </template>
          </div>
          <p class="small" x-show="$store.session.signInUnavailable">Sign-in is not available yet.</p>
          <p class="small" x-show="$store.session.providersState === 'error'">Could not check the sign-in options. Reload the page to try again.</p>
          <p class="error" x-show="$store.session.error" x-text="$store.session.error" role="alert"></p>
        </div>
        <div x-show="$store.session.signedIn" class="actions">
          <button class="btn" data-variant="outline" type="button" :aria-pressed="Boolean(liked)" :disabled="busy" @click="toggleLike()" x-text="`${liked ? 'Unlike' : 'Like'} · ${level?.likes ?? 0}`"></button>
          <button class="btn" data-variant="outline" type="button" :aria-expanded="reporting" aria-controls="report-form" @click="reporting = !reporting">Report</button>
        </div>
        <form id="report-form" class="report-form" x-show="reporting" @submit.prevent="sendReport()">
          <label class="field"><span>What is wrong with this level?</span><textarea name="reason" x-model="reason" required maxlength="1000" rows="3"></textarea></label>
          <button class="btn" type="submit" :disabled="busy || !reason.trim()">Send report</button>
        </form>
        <p class="notice" x-show="notice" x-text="notice" role="status"></p>
      </div>

      <div class="comments">
        <h2 x-show="commentsConfigured">Comments</h2>
        <div x-ref="comments"></div>
        <p class="small" x-show="!commentsConfigured">Comments are not switched on yet.</p>
      </div>
    </article>
  </section>

  <script>
    import { startGallery } from '../../../scripts/gallery-app.js';
    import levelView from '../../../scripts/level-view.js';

    startGallery({ levelView });
  </script>
</GalleryLayout>
