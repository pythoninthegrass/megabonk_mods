# Local settings for the site and its Compose file. Copy to .env and fill in; .env is gitignored and
# excluded from the Docker build context by .dockerignore.

# Docker Compose: host port that publishes the container's 8080. Loopback only.
SITE_PORT=8080

# Gallery API base URL, read at build time by the /levels/ and /l/<code> pages.
PUBLIC_PB_URL=http://127.0.0.1:8090

# Local PocketBase OAuth credentials (PB_OAUTH_*) are read from this file by Compose, or
# from the root .env with `docker compose --env-file ../.env`.

# giscus comment thread on each level page; the thread is skipped while any is empty.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
