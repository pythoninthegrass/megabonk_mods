# Local settings for the site. Copy to .env and fill in; .env is gitignored and
# excluded from the Docker build context by .dockerignore.

# Docker Compose: host port that publishes the container's 8080. Loopback only.
SITE_PORT=8080

# Dokploy control plane for the icarus CLI (ic). Run ic from this directory: it
# reads .env from the working directory and finds dokploy.yml by walking up.
# These configure the CLI only; dokploy.yml sets create_env_file: false, so none
# of them is pushed into the deployed container.
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
DOKPLOY_ENV=prod

# SSH target icarus uses for `ic logs` and `ic exec`.
DOKPLOY_SSH_HOST=
DOKPLOY_SSH_USER=
DOKPLOY_SSH_PORT=22

# Gallery API base URL, read at build time by the /levels/ and /l/<code> pages.
PUBLIC_PB_URL=http://127.0.0.1:8090

# giscus comment thread on each level page; the thread is skipped while any is empty.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
