{
  // The site's scripts run under Node (`node --test`, plain node); Deno only
  // lints and formats them, so nothing here asks for a Deno runtime.
  "exclude": [
    ".astro/",
    ".impeccable/",
    "dist/",
    "node_modules/"
  ],
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true,
    // markdownlint owns Markdown and pretty-format-json owns JSON; Deno would
    // fight them, and Astro/CSS/YAML formatting is behind unstable flags
    "exclude": [
      "**/*.astro",
      "**/*.css",
      "**/*.json",
      "**/*.jsonc",
      "**/*.md",
      "**/*.svg",
      "**/*.yaml",
      "**/*.yml"
    ]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        // Node globals are intentional: these files never run under Deno
        "no-process-global",
        // test stubs are async to match the interface they stand in for
        "require-await"
      ]
    }
  }
}
